# Use modern Docker/BuildKit's bundled frontend; avoid an extra registry pull.

# Apple Silicon Mac: Linux ARM64 CPU container, not macOS/Metal GPU.
# mlx-whisper is intentionally excluded: Docker Desktop cannot expose Metal.
# Build: docker build --platform linux/arm64 -f Dockerfile.mac -t videoprinterturbo:mac .
# Run: docker run -d --platform linux/arm64 -p 8000:8000 videoprinterturbo:mac
# In ASR settings select local OpenAI Whisper.
ARG PYTHON_IMAGE=python:3.11-slim-bullseye
ARG RUNTIME_PLATFORM=linux/arm64

FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS frontend
WORKDIR /VideoPrinterTurbo/front
COPY front/package.json front/package-lock.json ./
RUN npm ci
# Copy only build inputs, excluding host node_modules, dist and .env files.
COPY front/index.html front/tsconfig*.json front/vite.config.ts ./
COPY front/src ./src
COPY front/public ./public
RUN VITE_API_BASE_URL=/api npm run build

FROM --platform=${RUNTIME_PLATFORM} ${PYTHON_IMAGE} AS runtime
USER root
RUN test "$(uname -m)" = "aarch64"
ENV CUDA_VISIBLE_DEVICES="" \
    NVIDIA_VISIBLE_DEVICES=void \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/VideoPrinterTurbo/.venv/bin:$PATH"
WORKDIR /VideoPrinterTurbo

RUN sed -i 's|deb http://deb.debian.org/debian-security|deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260903T220410Z/|' /etc/apt/sources.list \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends \
       nginx supervisor ffmpeg libgomp1 libasound2 ca-certificates \
       build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY server/pyproject.toml /tmp/backend-pyproject.toml
# mlx-whisper is only used on Apple Silicon/macOS, not in Linux containers.
# Generate a requirements file without changing the repository's pyproject.toml.
# Other dependencies retain the constraints declared by the project.
RUN python -m venv /VideoPrinterTurbo/.venv
RUN python - <<'PY'
import pathlib
import tomllib

project = tomllib.loads(pathlib.Path('/tmp/backend-pyproject.toml').read_text())
requirements = [d for d in project['project']['dependencies']
                if not d.startswith('mlx-whisper')]
pathlib.Path('/tmp/requirements.txt').write_text('\n'.join(requirements) + '\n')
PY
# Install PyTorch from the CPU-only index first, then constrain its exact build
# so installing openai-whisper cannot replace it with a CUDA-enabled wheel.
ARG TORCH_VERSION=2.10.0
RUN python -m pip install "torch==${TORCH_VERSION}" --index-url https://download.pytorch.org/whl/cpu \
    && python -c "from importlib.metadata import version; print('torch==' + version('torch'))" > /tmp/torch-constraints.txt \
    && python -m pip install -c /tmp/torch-constraints.txt -r /tmp/requirements.txt \
    && python -m pip check \
    && python -c "import torch; assert torch.version.cuda is None, 'Expected CPU-only PyTorch'" \
    && rm /tmp/requirements.txt /tmp/backend-pyproject.toml /tmp/torch-constraints.txt

# Explicit copies avoid bundling local databases, virtualenvs and credentials.
COPY server/*.py server/pyproject.toml server/README.md ./server/
COPY server/config ./server/config
COPY server/middleware ./server/middleware
COPY server/models ./server/models
COPY server/pipeline ./server/pipeline
COPY server/resources ./server/resources
COPY server/routers ./server/routers
COPY server/service ./server/service
COPY server/utils ./server/utils
COPY i18n.json ./i18n.json
COPY downloader.json.sample.json ./downloader.json
COPY config.yaml.sample ./config.yaml
COPY --from=frontend /VideoPrinterTurbo/front/dist ./front/dist

# The sample lacks storage settings. Supply container defaults; a bind-mounted
# /VideoPrinterTurbo/config.yaml can override the complete configuration.
RUN python - <<'PY'
from pathlib import Path
import yaml

path = Path('/VideoPrinterTurbo/config.yaml')
config = yaml.safe_load(path.read_text())
config['app']['debug'] = False
config['storage'] = {
    'path': 'storage', 'upload': 'storage/upload',
    'download': 'storage/downloads', 'subtitle': 'storage/subtitle',
    'video_to_text': 'storage/video_to_text', 'llm_rewrite': 'storage/llm_rewrite',
    'tts_rewrite': 'storage/tts_rewrite', 'material': 'storage/material',
    'output': 'output',
}
path.write_text(yaml.safe_dump(config, allow_unicode=True, sort_keys=False))
PY

# Nginx serves the SPA and strips /api/ before forwarding to FastAPI.
COPY <<'NGINX' /etc/nginx/nginx.conf
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    client_body_temp_path /tmp/nginx_client;
    proxy_temp_path /tmp/nginx_proxy;
    server {
        listen 8000;
        server_name _;
        root /VideoPrinterTurbo/front/dist;
        index index.html;
        client_max_body_size 2g;
        location /api/ {
            proxy_pass http://127.0.0.1:8080/;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 600s;
            proxy_redirect / /api/;
        }
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
NGINX

# Supervisor forwards container shutdown to both services and reaps children.
COPY <<'SUPERVISOR' /etc/supervisor/vpt.conf
[supervisord]
nodaemon=true
logfile=/dev/null
pidfile=/tmp/supervisord.pid
childlogdir=/tmp

[program:backend]
directory=/VideoPrinterTurbo/server
command=/VideoPrinterTurbo/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8080 --proxy-headers --forwarded-allow-ips=127.0.0.1
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=30
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:frontend]
command=/usr/sbin/nginx -g "daemon off;"
autorestart=true
stopsignal=QUIT
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
SUPERVISOR

RUN mkdir -p server/db storage output /home/vpt /tmp/nginx_client /tmp/nginx_proxy \
    && touch /tmp/nginx.pid \
    && chown -R 10001:10001 /VideoPrinterTurbo /home/vpt \
    && chown 10001:10001 /tmp/nginx.pid /tmp/nginx_client /tmp/nginx_proxy \
    && nginx -t
ENV HOME=/home/vpt
USER 10001:10001
WORKDIR /VideoPrinterTurbo/server
# Persist these paths with named volumes or writable bind mounts.
VOLUME ["/VideoPrinterTurbo/server/db", "/VideoPrinterTurbo/storage", "/VideoPrinterTurbo/output", "/home/vpt/.cache"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/', timeout=2); urllib.request.urlopen('http://127.0.0.1:8000/api/openapi.json', timeout=2)" || exit 1
ENTRYPOINT ["/usr/bin/supervisord", "-c", "/etc/supervisor/vpt.conf"]
