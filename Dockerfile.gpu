# Use modern Docker/BuildKit's bundled frontend; avoid an extra registry pull.

# NVIDIA CUDA: docker build --platform linux/amd64 -f Dockerfile.gpu -t videoprinterturbo:gpu .
# Run on a NVIDIA host with NVIDIA Container Toolkit and a CUDA 12.8-compatible driver:
# docker run -d --gpus all -p 8000:8000 videoprinterturbo:gpu
# In ASR settings select local Faster Whisper (or OpenAI Whisper).
# CUDA libraries come from the official PyTorch cu128 wheels.
ARG PYTHON_IMAGE=python:3.11-slim-bullseye

FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS frontend
WORKDIR /VideoPrinterTurbo/front
COPY front/package.json front/package-lock.json ./
RUN npm ci
# Copy only build inputs, excluding host node_modules, dist and .env files.
COPY front/index.html front/tsconfig*.json front/vite.config.ts ./
COPY front/src ./src
COPY front/public ./public
RUN VITE_API_BASE_URL=/api npm run build

FROM ${PYTHON_IMAGE} AS runtime
USER root
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    LD_LIBRARY_PATH="/VideoPrinterTurbo/.venv/lib/python3.11/site-packages/nvidia/cublas/lib:/VideoPrinterTurbo/.venv/lib/python3.11/site-packages/nvidia/cudnn/lib:/VideoPrinterTurbo/.venv/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:/VideoPrinterTurbo/.venv/lib/python3.11/site-packages/nvidia/cufft/lib:/VideoPrinterTurbo/.venv/lib/python3.11/site-packages/nvidia/curand/lib:/VideoPrinterTurbo/.venv/lib/python3.11/site-packages/nvidia/cuda_nvrtc/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64" \
    AUDIO_SEPARATOR_MODEL_DIR=/home/vpt/.cache/audio-separator \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=5 \
    PATH="/VideoPrinterTurbo/.venv/bin:$PATH"
WORKDIR /VideoPrinterTurbo

RUN sed -i 's|deb http://deb.debian.org/debian-security|deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260903T220410Z/|' /etc/apt/sources.list \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends \
       nginx supervisor ffmpeg libgomp1 libasound2 ca-certificates \
       build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY server/pyproject.toml /tmp/backend-pyproject.toml
# mlx-whisper is only used on Apple Silicon/macOS, not in Linux containers.
# Generate a requirements file without changing the repository's pyproject.toml.
# Other dependencies retain the constraints declared by the project.
RUN python -m venv /VideoPrinterTurbo/.venv
RUN python - <<'PY'
import pathlib
import tomllib

project = tomllib.loads(pathlib.Path('/tmp/backend-pyproject.toml').read_text())
requirements = [d for d in project['project']['dependencies']
                if not d.startswith('mlx-whisper')]
requirements = [d.replace('audio-separator[cpu]', 'audio-separator[gpu]') for d in requirements]
pathlib.Path('/tmp/requirements.txt').write_text('\n'.join(requirements) + '\n')
PY
# Install the CUDA 12.8 PyTorch build and its NVIDIA runtime dependencies.
# CTranslate2 uses CUDA 12 / cuDNN 9; expose those wheel libraries above.
# Pin PyTorch and torchvision to matching CUDA builds.
# Faster Whisper requires the CPU ORT distribution metadata; reinstall the
# resolved GPU wheel last so the shared onnxruntime module uses CUDA.
ARG TORCH_VERSION=2.10.0
ARG TORCHVISION_VERSION=0.25.0
# PyPI ORT 1.27+ defaults to CUDA 13; this image uses CUDA 12.8.
ARG ONNXRUNTIME_GPU_VERSION=1.26.0
RUN python -m pip install "torch==${TORCH_VERSION}" "torchvision==${TORCHVISION_VERSION}" --index-url https://download.pytorch.org/whl/cu128 \
    && python -c "from importlib.metadata import version; print('torch==' + version('torch')); print('torchvision==' + version('torchvision'))" > /tmp/torch-constraints.txt \
    && python -m pip install -c /tmp/torch-constraints.txt -r /tmp/requirements.txt "ctranslate2==4.6.0" "onnxruntime==${ONNXRUNTIME_GPU_VERSION}" "onnxruntime-gpu==${ONNXRUNTIME_GPU_VERSION}" \
    && python -m pip install --no-deps --force-reinstall "onnxruntime-gpu==${ONNXRUNTIME_GPU_VERSION}" \
    && python -m pip check \
    && python -c "import torch; assert torch.version.cuda == '12.8', 'Expected CUDA 12.8 PyTorch'" \
    && python -c "import ctypes; ctypes.CDLL('libcublas.so.12'); ctypes.CDLL('libcudnn.so.9'); import ctranslate2" \
    && python -c "import torch; import onnxruntime as ort; ort.preload_dlls(directory=''); import ctypes; from pathlib import Path; ctypes.CDLL(str(Path(ort.__file__).parent / 'capi' / 'libonnxruntime_providers_cuda.so')); assert 'CUDAExecutionProvider' in ort.get_available_providers(), ort.get_available_providers()" \
    && rm /tmp/requirements.txt /tmp/backend-pyproject.toml /tmp/torch-constraints.txt

RUN mkdir -p "$AUDIO_SEPARATOR_MODEL_DIR" \
    && python -c "from audio_separator.separator import Separator; import soundfile; import torchvision" \
    && audio-separator --env_info \
    && ffmpeg -hide_banner -filters 2>&1 | grep -w subtitles

# Explicit copies avoid bundling local databases, virtualenvs and credentials.
COPY server/*.py server/pyproject.toml server/README.md ./server/
COPY server/config ./server/config
COPY server/middleware ./server/middleware
COPY server/models ./server/models
COPY server/pipeline ./server/pipeline
COPY server/resources ./server/resources
COPY server/routers ./server/routers
COPY server/service ./server/service
COPY server/utils ./server/utils
COPY i18n.json ./i18n.json
COPY downloader.json.sample.json ./downloader.json
COPY config.yaml.sample ./config.yaml
COPY --from=frontend /VideoPrinterTurbo/front/dist ./front/dist

# Preserve sample storage settings and fill missing container defaults; a bind-mounted
# /VideoPrinterTurbo/config.yaml can override the complete configuration.
RUN python - <<'PY'
from pathlib import Path
import yaml

path = Path('/VideoPrinterTurbo/config.yaml')
config = yaml.safe_load(path.read_text())
config['app']['debug'] = False
storage_defaults = {
    'path': 'storage', 'upload': 'storage/upload',
    'download': 'storage/downloads', 'subtitle': 'storage/subtitle',
    'video_to_text': 'storage/video_to_text', 'audio_separator': 'storage/audio_separator',
    'llm_rewrite': 'storage/llm_rewrite',
    'tts_rewrite': 'storage/tts_rewrite', 'material': 'storage/material',
    'output': 'output',
}
storage = config.setdefault('storage', {})
for key, value in storage_defaults.items():
    storage.setdefault(key, value)
path.write_text(yaml.safe_dump(config, allow_unicode=True, sort_keys=False))
PY

# Nginx serves the SPA and strips /api/ before forwarding to FastAPI.
COPY <<'NGINX' /etc/nginx/nginx.conf
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    client_body_temp_path /tmp/nginx_client;
    proxy_temp_path /tmp/nginx_proxy;
    server {
        listen 8000;
        server_name _;
        root /VideoPrinterTurbo/front/dist;
        index index.html;
        client_max_body_size 2g;
        location /api/ {
            proxy_pass http://127.0.0.1:8080/;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 600s;
            proxy_redirect / /api/;
        }
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
NGINX

# Supervisor forwards container shutdown to both services and reaps children.
COPY <<'SUPERVISOR' /etc/supervisor/vpt.conf
[supervisord]
nodaemon=true
logfile=/dev/null
pidfile=/tmp/supervisord.pid
childlogdir=/tmp

[program:backend]
directory=/VideoPrinterTurbo/server
command=/VideoPrinterTurbo/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8080 --proxy-headers --forwarded-allow-ips=127.0.0.1
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=30
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:frontend]
command=/usr/sbin/nginx -g "daemon off;"
autorestart=true
stopsignal=QUIT
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
SUPERVISOR

RUN mkdir -p server/db storage output /home/vpt/.cache/audio-separator /tmp/nginx_client /tmp/nginx_proxy \
    && touch /tmp/nginx.pid \
    && chown -R 10001:10001 /VideoPrinterTurbo /home/vpt \
    && chown 10001:10001 /tmp/nginx.pid /tmp/nginx_client /tmp/nginx_proxy \
    && nginx -t
ENV HOME=/home/vpt
USER 10001:10001
WORKDIR /VideoPrinterTurbo/server
# Persist these paths with named volumes or writable bind mounts.
VOLUME ["/VideoPrinterTurbo/server/db", "/VideoPrinterTurbo/storage", "/VideoPrinterTurbo/output", "/home/vpt/.cache"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/', timeout=2); urllib.request.urlopen('http://127.0.0.1:8000/api/openapi.json', timeout=2)" || exit 1
ENTRYPOINT ["/usr/bin/supervisord", "-c", "/etc/supervisor/vpt.conf"]
